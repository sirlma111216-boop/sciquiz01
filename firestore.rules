rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  과학 진짜? 가짜? — Firestore 보안 규칙
// ─────────────────────────────────────────────────────────────
//
//  이 규칙이 보장하는 것
//   1. 학생은 자기 답안만 만들 수 있다.
//   2. 한 번 낸 답안은 학생이 고치거나 지울 수 없다.
//   3. 학생은 다른 학생의 점수를 바꿀 수 없다. (점수는 교사만 씀)
//   4. 학생은 게임 진행 단계(phase)를 바꿀 수 없다.
//   5. 학생은 명예의 전당 기록을 만들거나 고칠 수 없다.
//   6. 제한 시간이 지난 뒤에는 답안이 서버에서 거부된다.
//   7. 같은 문제에 두 번 제출할 수 없다. (문서 이름이 고정됨)
//
//  교사와 학생은 로그인 방식으로 구분한다.
//   - 교사: 이메일/비밀번호 (password)
//   - 학생: 익명 로그인 (anonymous)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isStudent() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // 각 문서에 teacherUid 를 함께 저장해 두기 때문에
    // 채점처럼 문서를 많이 쓰는 작업에서도 별도 조회 없이 주인을 확인할 수 있다.
    function ownsExisting() {
      return isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    function ownsIncoming() {
      return isTeacher() && request.resource.data.teacherUid == request.auth.uid;
    }

    /* ── 시계 맞추기용 개인 문서 ── */
    match /clockSync/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /* ── 게임 코드 → 방 id ── */
    match /roomCodes/{code} {
      // 학생이 코드를 입력해 방을 찾을 수 있어야 한다.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if ownsIncoming();
      allow update: if false;
      allow delete: if ownsExisting();
    }

    /* ── 게임방 ── */
    match /rooms/{roomId} {

      function room() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data;
      }

      // 답안 제출이 지금 이 순간 유효한지 한 번의 조회로 모두 확인한다.
      // (규칙 한 번을 평가할 때 쓸 수 있는 문서 조회 횟수가 제한되어 있다.)
      function isOpenForRound(submitted) {
        let rm = room();
        return rm.phase == 'question'
          && rm.currentRound == submitted.roundIndex
          && rm.teacherUid == submitted.teacherUid
          // 제한 시간이 지나면 서버가 거부한다. (네트워크 지연 2초 여유)
          && request.time < rm.questionStartedAt
                            + duration.value(rm.duration, 's')
                            + duration.value(2, 's');
      }

      // 방 문서에는 문제 문장 / 정답 / 해설이 들어 있지 않다.
      allow get: if isSignedIn();
      // 교사가 자기 게임 목록을 볼 때만 목록 조회를 허용한다.
      allow list: if isTeacher() && resource.data.teacherUid == request.auth.uid;

      allow create: if ownsIncoming()
        && request.resource.data.phase == 'waiting'
        && request.resource.data.currentRound == -1
        && request.resource.data.status == 'open';

      // 진행 단계 변경은 오직 교사만 가능하다.
      allow update: if ownsExisting()
        && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if ownsExisting();

      /* 문제 목록 — 교사만 읽을 수 있다.
         학생 클라이언트는 어떤 문제가 나올지 미리 알 수 없다. */
      match /private/{docId} {
        allow read: if ownsExisting();
        allow create: if ownsIncoming();
        allow update: if ownsExisting() && ownsIncoming();
        allow delete: if ownsExisting();
      }

      /* 참가 학생 */
      match /participants/{uid} {
        // 대기실과 순위 표시를 위해 같은 방 참가자는 서로 볼 수 있다.
        allow read: if isSignedIn();

        // 학생은 자기 문서를 딱 한 번, 정해진 초기값으로만 만들 수 있다.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.score == 500
          && request.resource.data.recoveryNeeded == false
          && request.resource.data.recoveryRound == null
          && request.resource.data.previousRank == null
          && request.resource.data.lastResult == null
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 12
          // teacherUid 를 스스로 정할 수 없게 실제 방 주인과 대조한다.
          && request.resource.data.teacherUid == room().teacherUid;

        // 점수 변경은 교사만 가능하다. 학생은 자기 점수도 바꿀 수 없다.
        allow update: if ownsExisting()
          && request.resource.data.teacherUid == resource.data.teacherUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.nickname == resource.data.nickname;
        allow delete: if ownsExisting();
      }

      /* 닉네임 중복 방지 */
      match /nicknames/{nick} {
        allow read: if isSignedIn();
        // 이미 있으면 create 자체가 실패하므로 같은 방에서 닉네임이 겹치지 않는다.
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isTeacher();
      }

      /* 답안 */
      match /answers/{answerId} {

        // 자기 답안만 읽을 수 있다. 목록 조회는 교사만 가능하다.
        allow get: if isSignedIn()
          && (
            answerId.matches('r[0-9]+__' + request.auth.uid)
            || (isTeacher() && room().teacherUid == request.auth.uid)
          );
        allow list: if isTeacher() && room().teacherUid == request.auth.uid;

        allow create: if isStudent()
          // 문서 이름을 라운드 + 내 uid 로 고정한다.
          // → 같은 문제에 두 번 제출할 수 없고, 남의 이름으로도 만들 수 없다.
          && answerId == 'r' + string(request.resource.data.roundIndex) + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly([
               'uid', 'roundIndex', 'choice', 'confidencePoints',
               'submittedAt', 'teacherUid', 'scoreApplied'
             ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.choice is bool
          && request.resource.data.confidencePoints in [50, 100, 150, 200]
          && request.resource.data.scoreApplied == false
          && request.resource.data.submittedAt == request.time
          // 지금 진행 중인 문제인지, 제한 시간 안인지 서버에서 확인한다.
          && isOpenForRound(request.resource.data);

        // 제출한 답은 학생이 고칠 수 없다. 채점 결과는 교사만 기록한다.
        allow update: if ownsExisting();
        allow delete: if false;
      }

      /* 라운드 결과 통계 — 정답 공개 시점에 교사가 만든다. */
      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow create: if ownsIncoming();
        allow update: if ownsExisting() && ownsIncoming();
        allow delete: if false;
      }
    }

    /* ── 명예의 전당 ── */
    match /leaderboards/{entryId} {
      // 기록 보기는 로그인 없이도 가능하다. (닉네임·학급·점수만 저장)
      allow read: if true;
      // 학생은 기록을 만들거나 고칠 수 없다.
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }
  }
}
